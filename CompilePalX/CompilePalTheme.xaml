<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Themes/light.orange.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="CompilePal.Window" TargetType="controls:MetroWindow">
        <Setter Property="Background" Value="{DynamicResource CompilePal.Brushes.Canvas}"/>
        <Setter Property="Foreground" Value="{DynamicResource CompilePal.Brushes.Text}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CompilePal.Brushes.Border}"/>
        <Setter Property="NonActiveBorderBrush" Value="{DynamicResource CompilePal.Brushes.Border}"/>
        <Setter Property="WindowTitleBrush" Value="{DynamicResource CompilePal.Brushes.Surface}"/>
        <Setter Property="NonActiveWindowTitleBrush" Value="{DynamicResource CompilePal.Brushes.Surface}"/>
        <Setter Property="TitleForeground" Value="{DynamicResource CompilePal.Brushes.Text}"/>
        <Setter Property="OverrideDefaultWindowCommandsBrush" Value="{DynamicResource CompilePal.Brushes.Text}"/>
        <Setter Property="WindowTransitionsEnabled" Value="False"/>
        <Setter Property="TitleCharacterCasing" Value="Normal"/>
        <Setter Property="TitleBarHeight" Value="34"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>

    <Style x:Key="CompilePal.Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CompilePal.Brushes.Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CompilePal.Brushes.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style x:Key="CompilePal.Heading" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="CompilePal.SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="CompilePal.Button" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource CompilePal.Brushes.Surface}"/>
        <Setter Property="Foreground" Value="{DynamicResource CompilePal.Brushes.Text}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CompilePal.Brushes.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="13,6"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border CornerRadius="5" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter RecognizesAccessKey="True"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource CompilePal.Brushes.Subtle}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource CompilePal.Brushes.Muted}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource CompilePal.Brushes.AccentSoft}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource CompilePal.Brushes.Accent}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="CompilePal.PrimaryButton" TargetType="Button" BasedOn="{StaticResource CompilePal.Button}">
        <Setter Property="Background" Value="{DynamicResource CompilePal.Brushes.Accent}"/>
        <Setter Property="Foreground" Value="{DynamicResource CompilePal.Brushes.OnAccent}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource CompilePal.Brushes.AccentHover}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource CompilePal.Brushes.Accent}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="CompilePal.IconButton" TargetType="Button" BasedOn="{StaticResource CompilePal.Button}">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style TargetType="ListBox" BasedOn="{StaticResource MahApps.Styles.ListBox}">
        <Setter Property="Background" Value="{DynamicResource CompilePal.Brushes.Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CompilePal.Brushes.Border}"/>
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource MahApps.Styles.TextBox}">
        <Setter Property="Background" Value="{DynamicResource CompilePal.Brushes.Surface}"/>
        <Setter Property="Foreground" Value="{DynamicResource CompilePal.Brushes.Text}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CompilePal.Brushes.Border}"/>
        <Setter Property="controls:ControlsHelper.CornerRadius" Value="4"/>
    </Style>
    <Style x:Key="CompilePal.ColumnHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource MahApps.Styles.DataGridColumnHeader}">
        <Setter Property="Background" Value="{DynamicResource CompilePal.Brushes.Subtle}"/>
        <Setter Property="Foreground" Value="{DynamicResource CompilePal.Brushes.Muted}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CompilePal.Brushes.Border}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Height" Value="29"/>
        <Setter Property="controls:ControlsHelper.ContentCharacterCasing" Value="Normal"/>
    </Style>
    <Style TargetType="DataGrid" BasedOn="{StaticResource MahApps.Styles.DataGrid}">
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource CompilePal.ColumnHeader}"/>
        <Setter Property="Background" Value="{DynamicResource CompilePal.Brushes.Surface}"/>
        <Setter Property="RowBackground" Value="{DynamicResource CompilePal.Brushes.Surface}"/>
        <Setter Property="Foreground" Value="{DynamicResource CompilePal.Brushes.Text}"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource CompilePal.Brushes.Border}"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="RowHeaderWidth" Value="0"/>
        <Setter Property="MinRowHeight" Value="30"/>
    </Style>
</ResourceDictionary>

<controls:MetroWindow x:Class="CompilePalX.LaunchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Style="{StaticResource CompilePal.Window}" Title="Compile Pal" Icon="..\CompilePalIcon.ico"
        ShowIconOnTitleBar="False" Height="558" Width="790" MinHeight="470" MinWidth="620">
    <Grid Margin="22,18,22,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="142"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border CornerRadius="9" Background="#232C35" Padding="24,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="0.85*"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Game library" FontSize="32" FontWeight="SemiBold" Foreground="#F5F5F2"/>
                    <TextBlock Text="Select a Source game to open its compile workspace." MaxWidth="284" HorizontalAlignment="Left"
                               TextWrapping="Wrap" Foreground="#C3CCD4" FontSize="14" Margin="0,5,0,0"/>
                </StackPanel>
                <Grid Grid.Column="1" IsHitTestVisible="False" ClipToBounds="True">
                    <Grid.Background>
                        <DrawingBrush TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
                            <DrawingBrush.Drawing>
                                <GeometryDrawing Geometry="M0,16 L0,0 16,0">
                                    <GeometryDrawing.Pen><Pen Brush="#33404B" Thickness="0.65"/></GeometryDrawing.Pen>
                                </GeometryDrawing>
                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                    </Grid.Background>
                    <Viewbox Margin="2,16,2,12">
                        <Canvas Width="292" Height="160">
                            <Path Data="M292,91 L182,146 L182,157 L292,102 Z" Fill="#293641" Stroke="#718492" StrokeThickness="1" StrokeLineJoin="Round"/>
                            <Path Data="M50,80 L182,146 L182,157 L50,91 Z" Fill="#384753" Stroke="#718492" StrokeThickness="1" StrokeLineJoin="Round"/>
                            <Path Data="M160,25 L292,91 L182,146 L50,80 Z" Fill="#4B5A68" Stroke="#718492" StrokeThickness="1" StrokeLineJoin="Round"/>
                            <Path Data="M171,30.5 L61,85.5 M182,36 L72,91 M193,41.5 L83,96.5 M204,47 L94,102 M215,52.5 L105,107.5 M226,58 L116,113 M237,63.5 L127,118.5 M248,69 L138,124 M259,74.5 L149,129.5 M270,80 L160,135 M281,85.5 L171,140.5 M149,30.5 L281,96.5 M138,36 L270,102 M127,41.5 L259,107.5 M116,47 L248,113 M105,52.5 L237,118.5 M94,58 L226,124 M83,63.5 L215,129.5 M72,69 L204,135 M61,74.5 L193,140.5" Stroke="#6F7F8C" StrokeThickness="0.6"/>
                            <!-- Back walls -->
                            <Path Data="M243.6,34.8 L236.45,38.375 L236.45,70.375 L243.6,66.8 Z" Fill="#394957" Stroke="#AAB5BF" StrokeThickness="1" StrokeLineJoin="Round"/>
                            <Path Data="M152.85,-3.43 L236.45,38.375 L236.45,70.375 L152.85,28.575 Z" Fill="#536271" Stroke="#AAB5BF" StrokeThickness="1" StrokeLineJoin="Round"/>
                            <Path Data="M160,-7 L243.6,34.8 L236.45,38.375 L152.85,-3.43 Z" Fill="#8897A4" Stroke="#AAB5BF" StrokeThickness="1" StrokeLineJoin="Round"/>
                            <Path Data="M160.55,0.42 L100.05,30.68 L100.05,62.68 L160.55,32.425 Z" Fill="#394957" Stroke="#AAB5BF" StrokeThickness="1" StrokeLineJoin="Round"/>
                            <Path Data="M92.35,26.83 L100.05,30.68 L100.05,62.68 L92.35,58.825 Z" Fill="#536271" Stroke="#AAB5BF" StrokeThickness="1" StrokeLineJoin="Round"/>
                            <Path Data="M152.85,-3.43 L160.55,0.42 L100.05,30.68 L92.35,26.83 Z" Fill="#8897A4" Stroke="#AAB5BF" StrokeThickness="1" StrokeLineJoin="Round"/>
                            <Path Data="M276.6,65.3 L269.45,68.875 L269.45,86.875 L276.6,83.3 Z" Fill="#394957" Stroke="#AAB5BF" StrokeThickness="1" StrokeLineJoin="Round"/>
                            <Path Data="M236.45,52.375 L269.45,68.875 L269.45,86.875 L236.45,70.375 Z" Fill="#536271" Stroke="#AAB5BF" StrokeThickness="1" StrokeLineJoin="Round"/>
                            <Path Data="M243.6,48.8 L276.6,65.3 L269.45,68.875 L236.45,52.375 Z" Fill="#8897A4" Stroke="#AAB5BF" StrokeThickness="1" StrokeLineJoin="Round"/>
                            <!-- Raised landing and steps -->
                            <Path Data="M213.35,43.825 L174.85,63.075 L174.85,78.075 L213.35,58.825 Z" Fill="#485968" Stroke="#BBC5CD" StrokeThickness="1" StrokeLineJoin="Round"/>
                            <Path Data="M122.05,36.68 L174.85,63.075 L174.85,78.075 L122.05,51.68 Z" Fill="#637482" Stroke="#BBC5CD" StrokeThickness="1" StrokeLineJoin="Round"/>
                            <Path Data="M160.55,17.42 L213.35,43.825 L174.85,63.075 L122.05,36.68 Z" Fill="#9EABB5" Stroke="#BBC5CD" StrokeThickness="1" StrokeLineJoin="Round"/>
                            <Path Data="M146.25,52.575 L140.2,55.6 L140.2,66.8 L146.25,63.78 Z" Fill="#485968" Stroke="#BBC5CD" StrokeThickness="1" StrokeLineJoin="Round"/>
                            <Path Data="M116,43.5 L140.2,55.6 L140.2,66.8 L116,54.7 Z" Fill="#637482" Stroke="#BBC5CD" StrokeThickness="1" StrokeLineJoin="Round"/>
                            <Path Data="M122.05,40.475 L146.25,52.575 L140.2,55.6 L116,43.5 Z" Fill="#9EABB5" Stroke="#BBC5CD" StrokeThickness="1" StrokeLineJoin="Round"/>
                            <Path Data="M140.2,59.3 L134.15,62.325 L134.15,69.825 L140.2,66.8 Z" Fill="#485968" Stroke="#BBC5CD" StrokeThickness="1" StrokeLineJoin="Round"/>
                            <Path Data="M109.95,50.225 L134.15,62.325 L134.15,69.825 L109.95,57.725 Z" Fill="#637482" Stroke="#BBC5CD" StrokeThickness="1" StrokeLineJoin="Round"/>
                            <Path Data="M116,47.2 L140.2,59.3 L134.15,62.325 L109.95,50.225 Z" Fill="#9EABB5" Stroke="#BBC5CD" StrokeThickness="1" StrokeLineJoin="Round"/>
                            <Path Data="M134.15,66.125 L128.1,69.15 L128.1,72.85 L134.15,69.825 Z" Fill="#485968" Stroke="#BBC5CD" StrokeThickness="1" StrokeLineJoin="Round"/>
                            <Path Data="M103.9,57.05 L128.1,69.15 L128.1,72.85 L103.9,60.75 Z" Fill="#637482" Stroke="#BBC5CD" StrokeThickness="1" StrokeLineJoin="Round"/>
                            <Path Data="M109.95,54.025 L134.15,66.125 L128.1,69.15 L103.9,57.05 Z" Fill="#9EABB5" Stroke="#BBC5CD" StrokeThickness="1" StrokeLineJoin="Round"/>
                            <!-- Door frame -->
                            <Path Data="M231.5,38.75 L220.5,44.25 L220.5,77.25 L231.5,71.75 Z" Fill="#394957" Stroke="#AAB5BF" StrokeThickness="1" StrokeLineJoin="Round"/>
                            <Path Data="M209.5,38.75 L220.5,44.25 L220.5,77.25 L209.5,71.75 Z" Fill="#536271" Stroke="#AAB5BF" StrokeThickness="1" StrokeLineJoin="Round"/>
                            <Path Data="M220.5,33.25 L231.5,38.75 L220.5,44.25 L209.5,38.75 Z" Fill="#8897A4" Stroke="#AAB5BF" StrokeThickness="1" StrokeLineJoin="Round"/>
                            <Path Data="M263.4,54.7 L252.4,60.2 L252.4,93.2 L263.4,87.7 Z" Fill="#394957" Stroke="#AAB5BF" StrokeThickness="1" StrokeLineJoin="Round"/>
                            <Path Data="M241.4,54.7 L252.4,60.2 L252.4,93.2 L241.4,87.7 Z" Fill="#536271" Stroke="#AAB5BF" StrokeThickness="1" StrokeLineJoin="Round"/>
                            <Path Data="M252.4,49.2 L263.4,54.7 L252.4,60.2 L241.4,54.7 Z" Fill="#8897A4" Stroke="#AAB5BF" StrokeThickness="1" StrokeLineJoin="Round"/>
                            <Path Data="M263.4,48.2 L252.4,53.7 L252.4,60.2 L263.4,54.7 Z" Fill="#485968" Stroke="#BBC5CD" StrokeThickness="1" StrokeLineJoin="Round"/>
                            <Path Data="M209.5,32.25 L252.4,53.7 L252.4,60.2 L209.5,38.75 Z" Fill="#637482" Stroke="#BBC5CD" StrokeThickness="1" StrokeLineJoin="Round"/>
                            <Path Data="M220.5,26.75 L263.4,48.2 L252.4,53.7 L209.5,32.25 Z" Fill="#9EABB5" Stroke="#BBC5CD" StrokeThickness="1" StrokeLineJoin="Round"/>
                            <!-- Foreground brushes -->
                            <Path Data="M133.6,75.3 L119.3,82.45 L119.3,95.95 L133.6,88.8 Z" Fill="#394957" Stroke="#AAB5BF" StrokeThickness="1" StrokeLineJoin="Round"/>
                            <Path Data="M84.1,64.85 L119.3,82.45 L119.3,95.95 L84.1,78.35 Z" Fill="#536271" Stroke="#AAB5BF" StrokeThickness="1" StrokeLineJoin="Round"/>
                            <Path Data="M98.4,57.7 L133.6,75.3 L119.3,82.45 L84.1,64.85 Z" Fill="#8897A4" Stroke="#AAB5BF" StrokeThickness="1" StrokeLineJoin="Round"/>
                            <Path Data="M199.6,85.1 L175.4,97.2 L175.4,120.7 L199.6,108.6 Z" Fill="#B65939" Stroke="#FFD0AE" StrokeThickness="1" StrokeLineJoin="Round"/>
                            <Path Data="M149,84 L175.4,97.2 L175.4,120.7 L149,107.5 Z" Fill="#DA8054" Stroke="#FFD0AE" StrokeThickness="1" StrokeLineJoin="Round"/>
                            <Path Data="M173.2,71.9 L199.6,85.1 L175.4,97.2 L149,84 Z" Fill="#FFB184" Stroke="#FFD0AE" StrokeThickness="1" StrokeLineJoin="Round"/>
                            <Path Data="M200.7,121.05 L192.45,125.18 L192.45,134.175 L200.7,130.05 Z" Fill="#394957" Stroke="#AAB5BF" StrokeThickness="1" StrokeLineJoin="Round"/>
                            <Path Data="M181.45,119.68 L192.45,125.18 L192.45,134.175 L181.45,128.675 Z" Fill="#536271" Stroke="#AAB5BF" StrokeThickness="1" StrokeLineJoin="Round"/>
                            <Path Data="M189.7,115.55 L200.7,121.05 L192.45,125.18 L181.45,119.68 Z" Fill="#8897A4" Stroke="#AAB5BF" StrokeThickness="1" StrokeLineJoin="Round"/>
                        </Canvas>
                    </Viewbox>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CompilePal.Card}" Padding="14,10,14,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="2,0,0,10">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Name="RefreshButton" Style="{StaticResource CompilePal.IconButton}" ToolTip="Refresh games"
                                AutomationProperties.Name="Refresh games" Click="RefreshButton_OnClick" Margin="0,0,8,0">
                            <icons:PackIconMaterial Kind="Refresh" VerticalAlignment="Center"/>
                        </Button>
                        <Button Name="AddButton" Style="{StaticResource CompilePal.Button}" Click="AddButton_OnClick">
                            <StackPanel Orientation="Horizontal"><icons:PackIconMaterial Kind="Plus" Width="14" Height="14" VerticalAlignment="Center"/><TextBlock Text="Add game" Margin="6,0,0,0"/></StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="Game configurations" Style="{StaticResource CompilePal.SectionTitle}"/>
                </DockPanel>
                <Grid x:Name="EmptyState" Grid.Row="1">
                    <Border BorderBrush="{DynamicResource CompilePal.Brushes.Border}" BorderThickness="0,1,0,0"/>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="18,4">
                        <Border Background="{DynamicResource CompilePal.Brushes.AccentSoft}" CornerRadius="9"
                                Width="40" Height="40" HorizontalAlignment="Center">
                            <icons:PackIconMaterial Kind="FolderSearchOutline" Width="22" Height="22" HorizontalAlignment="Center"
                                                    VerticalAlignment="Center" Foreground="{DynamicResource CompilePal.Brushes.Accent}"/>
                        </Border>
                        <TextBlock Text="No games found" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,3"/>
                        <TextBlock Text="Open Hammer for your game and refresh this list, or add a configuration manually."
                                   Foreground="{DynamicResource CompilePal.Brushes.Muted}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="365"/>
                    </StackPanel>
                </Grid>
                <Grid x:Name="FilledState" Grid.Row="1" Visibility="Collapsed">
                    <DataGrid x:Name="GameGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              MouseDoubleClick="Button_Click" SelectionMode="Single" HeadersVisibility="Column"
                              RowHeight="38" AutomationProperties.Name="Game configurations">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Game" Binding="{Binding Name}" Width="Auto" MinWidth="120"/>
                            <DataGridTextColumn Header="Game folder" Binding="{Binding GameFolder}" Width="*"/>
                            <DataGridTemplateColumn Width="38" CanUserResize="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Name="GameKebabButton" Style="{StaticResource CompilePal.IconButton}"
                                                ToolTip="Game actions" AutomationProperties.Name="Game actions"
                                                ContextMenuOpening="GameKebabButton_OnContextMenuOpening" Click="GameKebabButton_OnClick">
                                            <icons:PackIconMaterial Kind="DotsHorizontal"/>
                                            <Button.ContextMenu>
                                                <ContextMenu Placement="Bottom">
                                                    <MenuItem Header="Edit" Click="EditButton_OnClick"/>
                                                    <MenuItem Header="Delete" Click="DeleteButton_OnClick"/>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>
        </Border>
        <DockPanel Grid.Row="3" Margin="0,16,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Style="{StaticResource CompilePal.Button}" Click="SettingsButton_Click">
                <StackPanel Orientation="Horizontal">
                    <icons:PackIconMaterial Kind="CogOutline" Width="15" Height="15" VerticalAlignment="Center"/>
                    <TextBlock Text="Settings" Margin="7,0,0,0"/>
                </StackPanel>
            </Button>
            <Button Name="LaunchButton" DockPanel.Dock="Right" Style="{StaticResource CompilePal.PrimaryButton}"
                    Click="Button_Click" IsEnabled="{Binding ElementName=GameGrid, Path=SelectedItems.Count}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Open workspace"/>
                    <icons:PackIconMaterial Kind="ArrowRight" Width="15" Height="15" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </DockPanel>
    </Grid>
</controls:MetroWindow>
